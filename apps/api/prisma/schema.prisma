generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                   String       @id @default(cuid())
  googleId             String?      @unique
  email                String       @unique
  name                 String?
  avatarUrl            String?
  isAdmin              Boolean      @default(false)
  refreshToken         String?
  refreshTokenExpiresAt DateTime?
  activeNik            String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  nikLinks             NikLink[]
  ownedFamily          FamilyGroup? @relation("FamilyAdmin")
}

model NikIdentity {
  nik             String         @id
  status          MemberStatus   @default(ACTIVE)
  activeAccountId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  nikLinks        NikLink[]
  personNodes     PersonNode[]
  leaveRequests   LeaveRequest[]
}

model NikLink {
  id        String      @id @default(cuid())
  accountId String
  nik       String
  createdAt DateTime    @default(now())
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  identity  NikIdentity @relation(fields: [nik], references: [nik], onDelete: Cascade)

  @@unique([accountId, nik])
  @@index([nik])
  @@index([accountId])
}

model FamilyGroup {
  id            String         @id @default(cuid())
  name          String
  description   String?
  adminAccountId String        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  admin         Account        @relation("FamilyAdmin", fields: [adminAccountId], references: [id])
  leaveRequests LeaveRequest[]
  notifications Notification[]
  members       PersonNode[]
}

model Notification {
  id            String      @id @default(cuid())
  familyGroupId String
  type          String
  message       String
  personNodeId  String?
  createdAt     DateTime    @default(now())
  readAt        DateTime?
  familyGroup   FamilyGroup @relation(fields: [familyGroupId], references: [id])

  @@index([familyGroupId, createdAt])
}

model PersonNode {
  id                    String             @id @default(cuid())
  displayName           String
  birthDate             DateTime?
  birthPlace            String?
  deathDate             DateTime?
  bio                   String?
  avatarUrl             String?
  isDeceased            Boolean            @default(false)
  isPlaceholder         Boolean            @default(false)
  canvasX               Float              @default(0)
  canvasY               Float              @default(0)
  nikId                 String?
  familyGroupId         String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  gender                Gender?
  surname               String?
  familyGroup           FamilyGroup?       @relation(fields: [familyGroupId], references: [id])
  identity              NikIdentity?       @relation(fields: [nikId], references: [nik])
  photos                PersonPhoto[]
  relationshipsAsSource RelationshipEdge[] @relation("EdgeSource")
  relationshipsAsTarget RelationshipEdge[] @relation("EdgeTarget")

  @@unique([nikId, familyGroupId])
  @@index([familyGroupId])
}

model RelationshipEdge {
  id               String           @id @default(cuid())
  relationshipType RelationshipType
  sourceId         String
  targetId         String
  marriageDate     DateTime?
  divorceDate      DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  source           PersonNode       @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target           PersonNode       @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationshipType])
  @@index([sourceId])
  @@index([targetId])
}

model PersonPhoto {
  id           String     @id @default(cuid())
  url          String
  caption      String?
  takenAt      DateTime?
  sortOrder    Int        @default(0)
  personNodeId String
  createdAt    DateTime   @default(now())
  personNode   PersonNode @relation(fields: [personNodeId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id            String             @id @default(cuid())
  nikId         String
  familyGroupId String
  status        LeaveRequestStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  expiresAt     DateTime?
  familyGroup   FamilyGroup        @relation(fields: [familyGroupId], references: [id])
  identity      NikIdentity        @relation(fields: [nikId], references: [nik], onDelete: Cascade)

  @@unique([nikId, familyGroupId])
  @@index([familyGroupId])
}

model AuditLog {
  id              String   @id @default(cuid())
  familyGroupId   String
  actorAccountId  String
  action          String
  targetId        String?
  details         String?
  createdAt       DateTime @default(now())

  @@index([familyGroupId, createdAt])
}

enum Gender {
  MALE
  FEMALE
}

enum MemberStatus {
  ACTIVE
  DEACTIVATED
}

enum RelationshipType {
  PARENT_CHILD
  SPOUSE
  SIBLING
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
